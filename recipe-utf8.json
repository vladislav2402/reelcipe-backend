{"id":"01a0b607-0332-79fd-9402-66b9d2089a50","title":"неймовірно гарному торті","language":"UK","previewMediaId":null,"libraryState":"DRAFT","version":1,"createdAt":"2026-09-18T19:38:28.018537Z","updatedAt":"2026-09-18T19:38:28.018537Z","ingredients":[{"id":"01a0b607-0335-7fc7-b194-db5ade65514d","position":0,"name":"білки","amount":null,"amountMax":null,"unit":null,"originalText":"білків"},{"id":"01a0b607-0337-7eb5-bc13-b374fed4d004","position":1,"name":"желатин","amount":null,"amountMax":null,"unit":null,"originalText":"Желатин"},{"id":"01a0b607-0338-723c-87c6-f4a80ae069ca","position":2,"name":"молоко","amount":null,"amountMax":null,"unit":null,"originalText":"молоці"},{"id":"01a0b607-0339-7242-bd75-732f1e78a062","position":3,"name":"сир","amount":null,"amountMax":null,"unit":null,"originalText":"сиром"},{"id":"01a0b607-033a-7b57-ab3e-e5bc3d6db80f","position":4,"name":"цукрозам","amount":null,"amountMax":null,"unit":null,"originalText":"цукрозамом"},{"id":"01a0b607-033b-7109-bffe-1a1fc14ed22b","position":5,"name":"бісквіт","amount":null,"amountMax":null,"unit":null,"originalText":"бісквіт"},{"id":"01a0b607-033c-7ed1-bb12-39d19a970d5f","position":6,"name":"ягоди","amount":null,"amountMax":null,"unit":null,"originalText":"ягодами"}],"steps":[{"id":"01a0b607-033d-76f5-8d8b-21a0f9b016c4","position":0,"text":"Змішати всі інгредієнти тіста, окрім білків; збити білки і ввести їх у тісто."},{"id":"01a0b607-033e-7f42-8527-650ed10b128d","position":1,"text":"Вилити тісто у роз'ємну форму, накрити фольгою і випікати в духовці."},{"id":"01a0b607-033f-7fa3-aeae-317e378caab8","position":2,"text":"Розчинити желатин у гарячому молоці, змішати з сиром і цукрозамом."},{"id":"01a0b607-0340-7e0c-89cd-9511353afe7a","position":3,"text":"Охолодити бісквіт, вирізати середину, залишивши форму."},{"id":"01a0b607-0341-74ff-8117-15aa2722cf34","position":4,"text":"Розрізати бісквіт на шматочки."},{"id":"01a0b607-0342-7e76-9523-6671f11518d6","position":5,"text":"Наповнити форму сирною сумішшю, бісквітними шматочками та ягодами."},{"id":"01a0b607-0343-7e1b-a303-c9572f07b202","position":6,"text":"Поставити у холодильник на кілька годин."},{"id":"01a0b607-0343-7e1b-a303-c9572f07b203","position":7,"text":"Прикрасити ягодами, подати з запашною кавою."}]}