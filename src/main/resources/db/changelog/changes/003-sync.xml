<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="005-user-sync-state" author="reelcipe">
        <createTable tableName="user_sync_state">
            <column name="user_id" type="UUID">
                <constraints primaryKey="true" nullable="false" primaryKeyName="user_sync_state_pk"/>
            </column>
            <column name="last_sequence" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueDate="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="user_sync_state"
                baseColumnNames="user_id"
                constraintName="user_sync_state_user_fk"
                referencedTableName="users"
                referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="006-sync-changes" author="reelcipe">
        <createTable tableName="sync_changes">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false" primaryKeyName="sync_changes_pk"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="entity_type" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="entity_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="operation" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="sequence" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueDate="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="sync_changes"
                baseColumnNames="user_id"
                constraintName="sync_changes_user_fk"
                referencedTableName="users"
                referencedColumnNames="id"/>
        <addUniqueConstraint
                tableName="sync_changes"
                columnNames="user_id, sequence"
                constraintName="sync_changes_user_sequence_uq"/>
        <createIndex tableName="sync_changes" indexName="sync_changes_cursor_idx">
            <column name="user_id"/>
            <column name="sequence"/>
        </createIndex>
        <createIndex tableName="sync_changes" indexName="sync_changes_entity_idx">
            <column name="user_id"/>
            <column name="entity_type"/>
            <column name="entity_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
