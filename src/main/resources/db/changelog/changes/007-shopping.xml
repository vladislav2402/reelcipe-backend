<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">
    <changeSet id="013-shopping" author="reelcipe">
        <createTable tableName="shopping_lists">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false" primaryKeyName="shopping_lists_pk"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false" unique="true" uniqueConstraintName="shopping_lists_user_uq"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueDate="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueDate="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="shopping_lists" baseColumnNames="user_id"
                                 constraintName="shopping_lists_user_fk" referencedTableName="users"
                                 referencedColumnNames="id"/>

        <createTable tableName="shopping_items">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false" primaryKeyName="shopping_items_pk"/>
            </column>
            <column name="list_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="NUMERIC(18,6)"/>
            <column name="unit" type="VARCHAR(32)"/>
            <column name="checked" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueDate="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueDate="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="shopping_items" baseColumnNames="list_id"
                                 constraintName="shopping_items_list_fk" referencedTableName="shopping_lists"
                                 referencedColumnNames="id" onDelete="CASCADE"/>
        <createIndex tableName="shopping_items" indexName="shopping_items_list_idx">
            <column name="list_id"/>
            <column name="created_at"/>
        </createIndex>

        <createTable tableName="shopping_item_sources">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false" primaryKeyName="shopping_item_sources_pk"/>
            </column>
            <column name="list_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="item_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="recipe_id" type="UUID"/>
            <column name="recipe_version" type="BIGINT"/>
            <column name="ingredient_id" type="UUID"/>
            <column name="addition_id" type="UUID">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="shopping_item_sources" baseColumnNames="list_id"
                                 constraintName="shopping_item_sources_list_fk" referencedTableName="shopping_lists"
                                 referencedColumnNames="id" onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="shopping_item_sources" baseColumnNames="item_id"
                                 constraintName="shopping_item_sources_item_fk" referencedTableName="shopping_items"
                                 referencedColumnNames="id" onDelete="CASCADE"/>
        <addUniqueConstraint tableName="shopping_item_sources"
                             columnNames="list_id, addition_id, item_id"
                             constraintName="shopping_item_sources_addition_uq"/>
        <createIndex tableName="shopping_item_sources" indexName="shopping_item_sources_addition_idx">
            <column name="list_id"/>
            <column name="addition_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
