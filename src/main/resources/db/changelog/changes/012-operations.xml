<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">
    <changeSet id="012-operations" author="reelcipe">
        <createTable tableName="operation_outbox">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false" primaryKeyName="operation_outbox_pk"/>
            </column>
            <column name="event_type" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="aggregate_type" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="aggregate_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="deduplication_key" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="payload" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(16)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="attempts" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="next_attempt_at" type="TIMESTAMP WITH TIME ZONE" defaultValueDate="CURRENT_TIMESTAMP">
                <constraints nullable="true"/>
            </column>
            <column name="lease_owner" type="VARCHAR(255)"/>
            <column name="lease_version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="lease_until" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="last_error" type="VARCHAR(1000)"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueDate="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueDate="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="delivered_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
        <addUniqueConstraint tableName="operation_outbox"
                             columnNames="event_type, deduplication_key"
                             constraintName="operation_outbox_dedup_uq"/>
        <createIndex tableName="operation_outbox" indexName="operation_outbox_queue_idx">
            <column name="status"/>
            <column name="next_attempt_at"/>
            <column name="lease_until"/>
        </createIndex>

        <createTable tableName="deletion_tasks">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false" primaryKeyName="deletion_tasks_pk"/>
            </column>
            <column name="user_id" type="UUID"/>
            <column name="resource_type" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="resource_key" type="VARCHAR(1024)">
                <constraints nullable="false"/>
            </column>
            <column name="deduplication_key" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(16)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="attempts" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="next_attempt_at" type="TIMESTAMP WITH TIME ZONE" defaultValueDate="CURRENT_TIMESTAMP">
                <constraints nullable="true"/>
            </column>
            <column name="lease_owner" type="VARCHAR(255)"/>
            <column name="lease_version" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="lease_until" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="last_error" type="VARCHAR(1000)"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueDate="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueDate="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="completed_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
        <addUniqueConstraint tableName="deletion_tasks"
                             columnNames="deduplication_key"
                             constraintName="deletion_tasks_dedup_uq"/>
        <createIndex tableName="deletion_tasks" indexName="deletion_tasks_queue_idx">
            <column name="status"/>
            <column name="next_attempt_at"/>
            <column name="lease_until"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
