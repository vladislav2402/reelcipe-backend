<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">
    <changeSet id="017-recipe-finalization" author="reelcipe">
        <createTable tableName="recipe_imports">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false" primaryKeyName="recipe_imports_pk"/>
            </column>
            <column name="recipe_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="import_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="source_coverage" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="review_required" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueDate="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="recipe_imports"
                                 baseColumnNames="recipe_id"
                                 constraintName="recipe_imports_recipe_fk"
                                 referencedTableName="recipes"
                                 referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="recipe_imports"
                                 baseColumnNames="import_id"
                                 constraintName="recipe_imports_import_fk"
                                 referencedTableName="import_jobs"
                                 referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="recipe_imports"
                                 baseColumnNames="user_id"
                                 constraintName="recipe_imports_user_fk"
                                 referencedTableName="users"
                                 referencedColumnNames="id"/>
        <addUniqueConstraint tableName="recipe_imports"
                             columnNames="recipe_id"
                             constraintName="recipe_imports_recipe_uq"/>
        <addUniqueConstraint tableName="recipe_imports"
                             columnNames="import_id"
                             constraintName="recipe_imports_import_uq"/>

        <createTable tableName="recipe_evidence">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false" primaryKeyName="recipe_evidence_pk"/>
            </column>
            <column name="recipe_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="ingredient_id" type="UUID"/>
            <column name="step_id" type="UUID"/>
            <column name="source_type" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="transcription_id" type="UUID"/>
            <column name="segment_id" type="UUID"/>
            <column name="segment_index" type="INT"/>
            <column name="quote" type="VARCHAR(1000)">
                <constraints nullable="false"/>
            </column>
            <column name="start_ms" type="BIGINT"/>
            <column name="end_ms" type="BIGINT"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueDate="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="recipe_evidence"
                                 baseColumnNames="recipe_id"
                                 constraintName="recipe_evidence_recipe_fk"
                                 referencedTableName="recipes"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="recipe_evidence"
                                 baseColumnNames="ingredient_id"
                                 constraintName="recipe_evidence_ingredient_fk"
                                 referencedTableName="recipe_ingredients"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="recipe_evidence"
                                 baseColumnNames="step_id"
                                 constraintName="recipe_evidence_step_fk"
                                 referencedTableName="recipe_steps"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="recipe_evidence"
                                 baseColumnNames="transcription_id"
                                 constraintName="recipe_evidence_transcription_fk"
                                 referencedTableName="transcriptions"
                                 referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="recipe_evidence"
                                 baseColumnNames="segment_id"
                                 constraintName="recipe_evidence_segment_fk"
                                 referencedTableName="transcription_segments"
                                 referencedColumnNames="id"/>
        <createIndex tableName="recipe_evidence" indexName="recipe_evidence_recipe_idx">
            <column name="recipe_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
