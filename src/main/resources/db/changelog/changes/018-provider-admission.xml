<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">
    <changeSet id="018-provider-admission" author="reelcipe">
        <addColumn tableName="ai_attempts">
            <column name="provider_admission_id" type="UUID"/>
        </addColumn>

        <createTable tableName="provider_budget_periods">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false" primaryKeyName="provider_budget_periods_pk"/>
            </column>
            <column name="provider" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="period_start" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="period_end" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="budget_units" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="reserved_units" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="consumed_units" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="active_attempts" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="max_concurrent" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueDate="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueDate="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="provider_budget_periods"
                             columnNames="provider, period_start"
                             constraintName="provider_budget_periods_provider_start_uq"/>

        <createTable tableName="provider_admissions">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false" primaryKeyName="provider_admissions_pk"/>
            </column>
            <column name="attempt_id" type="UUID">
                <constraints nullable="false" unique="true" uniqueConstraintName="provider_admissions_attempt_uq"/>
            </column>
            <column name="import_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="provider" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="operation" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="estimated_units" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="charged_units" type="BIGINT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="state" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="failure_code" type="VARCHAR(128)"/>
            <column name="expires_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueDate="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueDate="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="provider_admissions"
                                 baseColumnNames="import_id"
                                 constraintName="provider_admissions_import_fk"
                                 referencedTableName="import_jobs"
                                 referencedColumnNames="id"/>
        <createIndex tableName="provider_admissions" indexName="provider_admissions_expiry_idx">
            <column name="state"/>
            <column name="expires_at"/>
        </createIndex>

        <createTable tableName="provider_user_failures">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false" primaryKeyName="provider_user_failures_pk"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="provider" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="window_start" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="failure_count" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="blocked_until" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueDate="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="provider_user_failures"
                             columnNames="user_id, provider, window_start"
                             constraintName="provider_user_failures_window_uq"/>
        <addForeignKeyConstraint baseTableName="provider_user_failures"
                                 baseColumnNames="user_id"
                                 constraintName="provider_user_failures_user_fk"
                                 referencedTableName="users"
                                 referencedColumnNames="id"/>
    </changeSet>
</databaseChangeLog>
