<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="004-idempotency-requests" author="reelcipe">
        <createTable tableName="idempotency_requests">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false" primaryKeyName="idempotency_requests_pk"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="operation" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="target" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="idempotency_key" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="request_hash" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="response_status" type="INT"/>
            <column name="response_body" type="TEXT"/>
            <column name="response_content_type" type="VARCHAR(255)"/>
            <column name="expires_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="completed_at" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueDate="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="idempotency_requests"
                baseColumnNames="user_id"
                constraintName="idempotency_requests_user_fk"
                referencedTableName="users"
                referencedColumnNames="id"/>
        <addUniqueConstraint
                tableName="idempotency_requests"
                columnNames="user_id, operation, target, idempotency_key"
                constraintName="idempotency_requests_scope_key_uq"/>
        <createIndex tableName="idempotency_requests" indexName="idempotency_requests_expiry_idx">
            <column name="expires_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
