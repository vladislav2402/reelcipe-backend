<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">
    <changeSet id="016-recipe-extraction" author="reelcipe">
        <createTable tableName="recipe_candidates">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false" primaryKeyName="recipe_candidates_pk"/>
            </column>
            <column name="import_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="input_hash" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="transcription_id" type="UUID"/>
            <column name="transcription_version" type="INT"/>
            <column name="schema_version" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="prompt_version" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="pipeline_version" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="language" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="source_coverage" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="candidate_json" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="provider" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="model" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueDate="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueDate="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="recipe_candidates"
                                 baseColumnNames="import_id"
                                 constraintName="recipe_candidates_import_fk"
                                 referencedTableName="import_jobs"
                                 referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="recipe_candidates"
                                 baseColumnNames="user_id"
                                 constraintName="recipe_candidates_user_fk"
                                 referencedTableName="users"
                                 referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="recipe_candidates"
                                 baseColumnNames="transcription_id"
                                 constraintName="recipe_candidates_transcription_fk"
                                 referencedTableName="transcriptions"
                                 referencedColumnNames="id"/>
        <addUniqueConstraint tableName="recipe_candidates"
                             columnNames="import_id, input_hash"
                             constraintName="recipe_candidates_input_uq"/>
        <createIndex tableName="recipe_candidates" indexName="recipe_candidates_import_idx">
            <column name="import_id"/>
            <column name="created_at" descending="true"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
