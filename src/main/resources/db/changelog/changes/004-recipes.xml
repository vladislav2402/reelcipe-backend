<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">
    <changeSet id="007-recipes" author="reelcipe">
        <createTable tableName="recipes">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false" primaryKeyName="recipes_pk"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="language" type="VARCHAR(16)"/>
            <column name="analysis_mode" type="VARCHAR(32)" defaultValue="MANUAL">
                <constraints nullable="false"/>
            </column>
            <column name="library_state" type="VARCHAR(32)" defaultValue="SAVED">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueDate="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP WITH TIME ZONE" defaultValueDate="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="recipes" baseColumnNames="user_id" constraintName="recipes_user_fk"
                                 referencedTableName="users" referencedColumnNames="id"/>
        <createIndex tableName="recipes" indexName="recipes_user_idx">
            <column name="user_id"/>
            <column name="updated_at" descending="true"/>
        </createIndex>
    </changeSet>
    <changeSet id="008-recipe-ingredients" author="reelcipe">
        <createTable tableName="recipe_ingredients">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false" primaryKeyName="recipe_ingredients_pk"/>
            </column>
            <column name="recipe_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="position" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="NUMERIC(18,6)"/>
            <column name="amount_max" type="NUMERIC(18,6)"/>
            <column name="unit" type="VARCHAR(32)"/>
            <column name="original_text" type="VARCHAR(1000)"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="recipe_ingredients" baseColumnNames="recipe_id"
                                 constraintName="recipe_ingredients_recipe_fk" referencedTableName="recipes"
                                 referencedColumnNames="id" onDelete="CASCADE"/>
        <createIndex tableName="recipe_ingredients" indexName="recipe_ingredients_recipe_idx">
            <column name="recipe_id"/>
            <column name="position"/>
        </createIndex>
    </changeSet>
    <changeSet id="009-recipe-steps" author="reelcipe">
        <createTable tableName="recipe_steps">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false" primaryKeyName="recipe_steps_pk"/>
            </column>
            <column name="recipe_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="position" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="text" type="VARCHAR(4000)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="recipe_steps" baseColumnNames="recipe_id"
                                 constraintName="recipe_steps_recipe_fk" referencedTableName="recipes"
                                 referencedColumnNames="id" onDelete="CASCADE"/>
        <createIndex tableName="recipe_steps" indexName="recipe_steps_recipe_idx">
            <column name="recipe_id"/>
            <column name="position"/>
        </createIndex>
    </changeSet>
    <changeSet id="010-recipe-revisions" author="reelcipe">
        <createTable tableName="recipe_revisions">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false" primaryKeyName="recipe_revisions_pk"/>
            </column>
            <column name="recipe_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="edited_by" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="snapshot" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueDate="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="recipe_revisions" baseColumnNames="recipe_id"
                                 constraintName="recipe_revisions_recipe_fk" referencedTableName="recipes"
                                 referencedColumnNames="id"/>
        <addUniqueConstraint tableName="recipe_revisions" columnNames="recipe_id, version"
                             constraintName="recipe_revisions_version_uq"/>
    </changeSet>
</databaseChangeLog>
